{
  "expo": {
    "name": "Ellington Personal Banking",
    "slug": "ellingtonbank",
    "version": "2.0.7",
    "orientation": "portrait",
    "icon": "./app/assets/Logo2.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ellingtonmfb.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "23",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver more relevant ads and measure campaign performance.",
        "NSAdvertisingAttributionReportEndpoint": "https://appsflyer-skadnetwork.com/",
        "AdAttributionKit": "https://appsflyer-skadnetwork.com/",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ]
      }
    },
    "android": {
      "package": "com.ellingtonmfb.app",
      "versionCode": 42,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/Logo2.png",
        "backgroundColor": "#3F401B"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./app/assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/logo.png",
          "resizeMode": "cover",
          "backgroundColor": "#3F401B",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBMessaging"],
            "deploymentTarget": "15.1"
          },
          "android": {
            "ndkVersion": "26.1.10909125",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "abiFilters": ["arm64-v8a"],
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-appsflyer",
        {
          "preferAppsFlyerBackupRules": false
        }
      ],
      "expo-notifications",
      "expo-secure-store"
      // "@react-native-firebase/app",
      // "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appsflyer": {
        "devKey": "hegvhjRZ9QU8ckb6hxgt28",
        "iosAppId": "6742980740"
      },
      "router": {},
      "eas": {
        "projectId": "2cb6bacc-1e05-4771-81c3-6a9934f26c7d"
      }
    }
  }
}
