{
  "expo": {
    "name": "Ellington Personal Banking",
    "slug": "ellingtonbank",
    "version": "2.1.14",
    "orientation": "portrait",
    "icon": "./app/assets/Logo2.png",
    "scheme": "ellingtonbank",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "139",
      "supportsTablet": true,
      "bundleIdentifier": "com.ellingtonmfb.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Allow Ellington Personal Banking to use Face ID for fast and secure login and transaction authorization.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver more relevant ads and measure campaign performance.",
        "NSCameraUsageDescription": "This app requires access to your camera to scan QR codes and capture verification documents.",
        "NSContactsUsageDescription": "This app requires access to your contacts to easily select recipients for transfers.",
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to select images for document verification.",
        "NSPhotoLibraryAddUsageDescription": "This app requires access to save verification documents to your photo library.",
        "NSMicrophoneUsageDescription": "This app requires access to your microphone when recording video verification clips.",
        "NSAdvertisingAttributionReportEndpoint": "https://appsflyer-skadnetwork.com/",
        "AdAttributionKit": "https://appsflyer-skadnetwork.com/",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.ellingtonmfb.app",
      "versionCode": 123,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/Logo2.png",
        "backgroundColor": "#3F401B"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./app/assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Ellington Personal Banking to use Face ID for fast and secure login and transaction authorization."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/logo.png",
          "resizeMode": "cover",
          "backgroundColor": "#3F401B",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging",
              "RNFBCrashlytics"
            ],
            "deploymentTarget": "15.1"
          },
          "android": {
            "ndkVersion": "26.1.10909125",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "abiFilters": [
              "arm64-v8a"
            ],
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-appsflyer",
        {
          "preferAppsFlyerBackupRules": false
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/messaging",
      "expo-web-browser",
      "expo-tracking-transparency",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appsflyer": {
        "devKey": "hegvhjRZ9QU8ckb6hxgt28",
        "iosAppId": "6742980740"
      },
      "router": {},
      "eas": {
        "projectId": "2cb6bacc-1e05-4771-81c3-6a9934f26c7d"
      }
    },
    "owner": "ellingtontech"
  }
}
